PROJECT_NAME           = "@CMAKE_PROJECT_NAME@"
PROJECT_NUMBER         = @VERSION_MAJOR@.@VERSION_MINOR@.@VERSION_PATCH@
STRIP_FROM_PATH        = @PROJECT_SOURCE_DIR@ \
                         @PROJECT_BINARY_DIR@
INPUT                  = @doxy_main_page@ \
                         @star2_SOURCE_DIR@/src/core \
                         @star2_SOURCE_DIR@/src/ode \
                         @star2_SOURCE_DIR@/src/gui \
                         @star2_SOURCE_DIR@/src/force_modules \
                         @star2_SOURCE_DIR@/src/star2.h \
                         @PROJECT_SOURCE_DIR@/README.md
FILE_PATTERNS          = *.h \
                         *.c \
                         *.cpp \
                         *.md
RECURSIVE              = YES
HTML_HEADER = @star2_SOURCE_DIR@/doxygen/doxygen-bootstrapped/header.html
HTML_FOOTER = @star2_SOURCE_DIR@/doxygen/doxygen-bootstrapped/footer.html
HTML_EXTRA_STYLESHEET  = @star2_SOURCE_DIR@/doxygen/doxygen-bootstrapped/customdoxygen.css
HTML_EXTRA_FILES       = @star2_SOURCE_DIR@/doxygen/doxygen-bootstrapped/doxy-boot.js
EXCLUDE                = @star2_SOURCE_DIR@/src/deprecated \
                         @star2_SOURCE_DIR@/src/deprecated
HAVE_DOT               = YES
USE_MATHJAX            = YES
PROJECT_BRIEF          = "A Simulation Tool for Automation and Robotics"
OPTIMIZE_OUTPUT_FOR_C  = YES
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/README.md
MARKDOWN_SUPPORT       = YES
GENERATE_XML           = YES
