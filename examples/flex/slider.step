ISO-10303-21;
HEADER;
/* a piston of 20 mm radius sliding along x, its crown from x = 18 to 40 mm, its wrist pin of 11 mm diameter about the z axis through the origin in bosses 7 to 15 mm either side of z = 0. In millimeters. Written by scripts/make_flex_step.py */
FILE_DESCRIPTION(('slider'),'2;1');
FILE_NAME('slider.step','2026-11-04T00:00:00',('shift'),(''),'scripts/make_track_step.py','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
