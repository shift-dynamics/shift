ISO-10303-21;
HEADER;
/* A cone of base radius 10 mm and height 20 mm, its base on z = 0 and its
   apex at (0, 0, 20) mm, in millimeters and radians (AP214). Two faces: the
   side, on a conical surface whose axis points down from the base (so that
   its semi-angle is positive), bounded by the base circle and by a vertex
   loop at the apex; and the planar base. No edge has a seam, and no edge
   carries curves in the parameters of its surfaces (pcurves): the repair
   computes them. Written by hand for the tests of shift's STEP repair
   (test/test_cad_repair.cc). */
FILE_DESCRIPTION(('cone 10 mm radius, 20 mm high'),'2;1');
FILE_NAME('cone_apex.step','2026-11-03T00:00:00',('shift'),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
/* product */
#1=APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('cone','cone','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#30);
/* units: millimeter and radian */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-06),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('',''));
/* shape */
#30=ADVANCED_BREP_SHAPE_REPRESENTATION('cone',(#40,#31),#14);
#31=AXIS2_PLACEMENT_3D('',#32,#33,#34);
#32=CARTESIAN_POINT('',(0.,0.,0.));
#33=DIRECTION('',(0.,0.,1.));
#34=DIRECTION('',(1.,0.,0.));
#35=DIRECTION('',(0.,0.,-1.));
#36=AXIS2_PLACEMENT_3D('',#32,#35,#34);
#40=MANIFOLD_SOLID_BREP('cone',#41);
#41=CLOSED_SHELL('',(#50,#51));
/* surfaces: radius 10 mm at the base, growing by tan(semi-angle) = 1/2 per
   unit distance down the axis, so that it vanishes 20 mm above the base */
#60=CONICAL_SURFACE('',#36,10.,0.463647609000806);
#61=PLANE('',#36);
/* vertices: on the base circle, and the apex */
#70=CARTESIAN_POINT('',(10.,0.,0.));
#71=CARTESIAN_POINT('',(0.,0.,20.));
#72=VERTEX_POINT('',#70);
#73=VERTEX_POINT('',#71);
/* the base circle, counterclockwise seen from above */
#80=CIRCLE('',#31,10.);
#100=EDGE_CURVE('base circle',#72,#72,#80,.T.);
/* faces */
#50=ADVANCED_FACE('side',(#110,#111),#60,.T.);
#110=FACE_OUTER_BOUND('',#112,.T.);
#112=EDGE_LOOP('',(#114));
#114=ORIENTED_EDGE('',*,*,#100,.T.);
#111=FACE_BOUND('',#113,.T.);
#113=VERTEX_LOOP('',#73);
#51=ADVANCED_FACE('base',(#115),#61,.T.);
#115=FACE_OUTER_BOUND('',#116,.T.);
#116=EDGE_LOOP('',(#117));
#117=ORIENTED_EDGE('',*,*,#100,.F.);
ENDSEC;
END-ISO-10303-21;
