ISO-10303-21;
HEADER;
/* A cylinder of radius 1 inch and height 2 inches, its axis along z from the
   origin, in inches and degrees (AP203). Three faces: the side, on a
   cylindrical surface with a seam along x at u = 0 and u = 360 degrees, and
   two planar ends. The circles and the seam carry their curves in the
   parameters of the cylinder (pcurves); the top circle also has its pcurve
   on the top plane, and the bottom circle has none on the bottom plane.
   Written by hand for the tests of shift's STEP reader
   (test/test_step_reader.cc). */
FILE_DESCRIPTION(('cylinder 1 in radius, 2 in high'),'2;1');
FILE_NAME('cylinder_inch.step','2026-11-03T00:00:00',('shift'),(''),'','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
/* product */
#1=APPLICATION_CONTEXT('configuration controlled 3D designs of mechanical parts and assemblies');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','config_control_design',1994,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('cylinder','cylinder','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#30);
/* units: inch and degree */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(25.4),#10);
#12=DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
#13=(CONVERSION_BASED_UNIT('INCH',#11)LENGTH_UNIT()NAMED_UNIT(#12));
#14=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#15=PLANE_ANGLE_MEASURE_WITH_UNIT(PLANE_ANGLE_MEASURE(0.0174532925199433),#14);
#16=DIMENSIONAL_EXPONENTS(0.,0.,0.,0.,0.,0.,0.);
#17=(CONVERSION_BASED_UNIT('DEGREE',#15)NAMED_UNIT(#16)PLANE_ANGLE_UNIT());
#18=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#19=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-05),#13,'distance_accuracy_value','');
#20=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#19))GLOBAL_UNIT_ASSIGNED_CONTEXT((#13,#17,#18))REPRESENTATION_CONTEXT('',''));
#21=(GEOMETRIC_REPRESENTATION_CONTEXT(2)PARAMETRIC_REPRESENTATION_CONTEXT()REPRESENTATION_CONTEXT('2D SPACE',''));
/* shape */
#30=ADVANCED_BREP_SHAPE_REPRESENTATION('cylinder',(#40,#31),#20);
#31=AXIS2_PLACEMENT_3D('',#32,#33,#34);
#32=CARTESIAN_POINT('',(0.,0.,0.));
#33=DIRECTION('',(0.,0.,1.));
#34=DIRECTION('',(1.,0.,0.));
#35=DIRECTION('',(0.,0.,-1.));
#36=CARTESIAN_POINT('',(0.,0.,2.));
#40=MANIFOLD_SOLID_BREP('cylinder',#41);
#41=CLOSED_SHELL('',(#50,#51,#52));
/* surfaces */
#60=CYLINDRICAL_SURFACE('',#31,1.);
#61=PLANE('',#62);
#62=AXIS2_PLACEMENT_3D('',#32,#35,#34);
#63=PLANE('',#64);
#64=AXIS2_PLACEMENT_3D('',#36,#33,#34);
/* vertices, where the seam meets the circles */
#70=CARTESIAN_POINT('',(1.,0.,0.));
#71=CARTESIAN_POINT('',(1.,0.,2.));
#72=VERTEX_POINT('',#70);
#73=VERTEX_POINT('',#71);
/* curves: the circles' parameter is in degrees, the seam's in inches */
#80=CIRCLE('',#31,1.);
#81=CIRCLE('',#82,1.);
#82=AXIS2_PLACEMENT_3D('',#36,#33,#34);
#83=LINE('',#70,#84);
#84=VECTOR('',#33,1.);
/* pcurves on the cylinder, in (u degrees, v inches) */
#90=PCURVE('',#60,#91);
#91=DEFINITIONAL_REPRESENTATION('',(#92),#21);
#92=LINE('',#93,#94);
#93=CARTESIAN_POINT('',(0.,0.));
#94=VECTOR('',#95,1.);
#95=DIRECTION('',(1.,0.));
#96=PCURVE('',#60,#97);
#97=DEFINITIONAL_REPRESENTATION('',(#98),#21);
#98=LINE('',#99,#94);
#99=CARTESIAN_POINT('',(0.,2.));
/* the seam at u = 360 degrees and at u = 0 */
#140=PCURVE('',#60,#141);
#141=DEFINITIONAL_REPRESENTATION('',(#142),#21);
#142=LINE('',#143,#145);
#143=CARTESIAN_POINT('',(360.,0.));
#144=PCURVE('',#60,#146);
#145=VECTOR('',#147,1.);
#146=DEFINITIONAL_REPRESENTATION('',(#148),#21);
#147=DIRECTION('',(0.,1.));
#148=LINE('',#93,#145);
/* the top circle on the top plane, in (u, v) inches */
#150=PCURVE('',#63,#151);
#151=DEFINITIONAL_REPRESENTATION('',(#152),#21);
#152=CIRCLE('',#153,1.);
#153=AXIS2_PLACEMENT_2D('',#93,#95);
/* edges */
#100=EDGE_CURVE('bottom circle',#72,#72,#101,.T.);
#101=SURFACE_CURVE('',#80,(#90),.CURVE_3D.);
#102=EDGE_CURVE('top circle',#73,#73,#103,.T.);
#103=SURFACE_CURVE('',#81,(#96,#150),.CURVE_3D.);
#106=EDGE_CURVE('seam',#72,#73,#107,.T.);
#107=SEAM_CURVE('',#83,(#140,#144),.CURVE_3D.);
/* faces */
#50=ADVANCED_FACE('side',(#110),#60,.T.);
#110=FACE_OUTER_BOUND('',#111,.T.);
#111=EDGE_LOOP('',(#112,#113,#114,#115));
#112=ORIENTED_EDGE('',*,*,#100,.T.);
#113=ORIENTED_EDGE('',*,*,#106,.T.);
#114=ORIENTED_EDGE('',*,*,#102,.F.);
#115=ORIENTED_EDGE('',*,*,#106,.F.);
#51=ADVANCED_FACE('bottom',(#116),#61,.T.);
#116=FACE_OUTER_BOUND('',#117,.T.);
#117=EDGE_LOOP('',(#118));
#118=ORIENTED_EDGE('',*,*,#100,.F.);
#52=ADVANCED_FACE('top',(#119),#63,.T.);
#119=FACE_OUTER_BOUND('',#120,.T.);
#120=EDGE_LOOP('',(#121));
#121=ORIENTED_EDGE('',*,*,#102,.T.);
ENDSEC;
END-ISO-10303-21;
