ISO-10303-21;
HEADER;
/* Track roller of an excavator track (20 t class), double flanged: two treads of 100 mm radius from 56 to 134 mm either side of its middle, on the link plates (the rails), flanges 25 mm high outside them to 154 mm, and a hub recessed by 10 mm between the treads. Axis along z through the origin, the middle at z = 0. In millimeters. Written by scripts/make_track_step.py for the tests of contact on STEP surfaces. */
FILE_DESCRIPTION(('track_roller'),'2;1');
FILE_NAME('track_roller.step','2026-11-04T00:00:00',('shift'),(''),'scripts/make_track_step.py','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
