ISO-10303-21;
HEADER;
/* An assembly of three instances of one part, a 10 mm cube with a corner at
   its origin, in millimeters (AP242). The cube is given by a shape
   representation (its placement) and, sharing its coordinates through a
   shape representation relationship, an advanced B-rep (its solid). The
   instances are placed
   1. at (100, 0, 0) by a representation relationship whose rep_1 is the
      cube's shape;
   2. at (0, 50, 0), turned 90 degrees about z, by one whose rep_1 is the
      assembly's shape, so that only the assembly usage tells which is the
      child;
   3. at (0, 0, 200) by a mapped item of the assembly's shape.
   Written by hand for the tests of shift's STEP reader
   (test/test_step_reader.cc). */
FILE_DESCRIPTION(('three cubes'),'2;1');
FILE_NAME('assembly_mm.step','2026-11-03T00:00:00',('shift'),(''),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
/* products */
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','ap242_managed_model_based_3d_engineering',2011,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('assembly','assembly','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
