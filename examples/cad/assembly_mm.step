#16=PRODUCT_DEFINITION_FORMATION('','',#15);
#17=PRODUCT_DEFINITION('design','',#16,#4);
#18=PRODUCT_DEFINITION_SHAPE('','',#17);
#19=SHAPE_DEFINITION_REPRESENTATION(#18,#40);
/* units and context */
#20=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-06),#20,'distance_accuracy_value','');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23))GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22))REPRESENTATION_CONTEXT('',''));
/* the assembly's shape: its origin, the placements of instances 1 and 2,
   and instance 3 */
#30=SHAPE_REPRESENTATION('assembly',(#31,#32,#33,#34),#24);
#31=AXIS2_PLACEMENT_3D('origin',#101,#304,#300);
#32=AXIS2_PLACEMENT_3D('instance 1',#310,#304,#300);
#33=AXIS2_PLACEMENT_3D('instance 2',#311,#304,#302);
#34=MAPPED_ITEM('instance 3',#35,#36);
#35=REPRESENTATION_MAP(#41,#40);
#36=AXIS2_PLACEMENT_3D('instance 3',#312,#304,#300);
/* the cube's shape and its solid */
#40=SHAPE_REPRESENTATION('cube',(#41),#24);
#41=AXIS2_PLACEMENT_3D('origin',#101,#304,#300);
#42=ADVANCED_BREP_SHAPE_REPRESENTATION('cube solid',(#50,#41),#24);
#43=SHAPE_REPRESENTATION_RELATIONSHIP('','',#40,#42);
/* instance 1: rep_1 is the cube */
#60=NEXT_ASSEMBLY_USAGE_OCCURRENCE('1','instance 1','',#7,#17,$);
#61=PRODUCT_DEFINITION_SHAPE('','',#60);
#62=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#63,#61);
#63=(REPRESENTATION_RELATIONSHIP('','',#40,#30)REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#64)SHAPE_REPRESENTATION_RELATIONSHIP());
#64=ITEM_DEFINED_TRANSFORMATION('','',#41,#32);
/* instance 2: rep_1 is the assembly */
#65=NEXT_ASSEMBLY_USAGE_OCCURRENCE('2','instance 2','',#7,#17,$);
#66=PRODUCT_DEFINITION_SHAPE('','',#65);
#67=CONTEXT_DEPENDENT_SHAPE_REPRESENTATION(#68,#66);
#68=(REPRESENTATION_RELATIONSHIP('','',#30,#40)REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION(#69)SHAPE_REPRESENTATION_RELATIONSHIP());
#69=ITEM_DEFINED_TRANSFORMATION('','',#33,#41);
/* the cube's solid */
#50=MANIFOLD_SOLID_BREP('cube',#51);
#51=CLOSED_SHELL('',(#140,#141,#142,#143,#144,#145));
#140=ADVANCED_FACE('bottom',(#150),#160,.T.);
