ISO-10303-21;
HEADER;
/* A box 10 x 20 x 30 mm (x, y, z) with a corner at the origin: a solid of
   six planar faces, twelve straight edges and eight vertices, in millimeters
   and radians. The solid is red and its top face green. Written by hand for
   the tests of shift's STEP reader (test/test_step_reader.cc). */
FILE_DESCRIPTION(('box 10 x 20 x 30 mm'),'2;1');
FILE_NAME('box_mm.step','2026-11-03T00:00:00',('shift'),(''),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
/* product */
#1=APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('box','box','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#20);
/* units and context */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-06),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('',''));
/* shape */
#20=ADVANCED_BREP_SHAPE_REPRESENTATION('box',(#30,#21),#14);
#21=AXIS2_PLACEMENT_3D('',#101,#304,#300);
#30=MANIFOLD_SOLID_BREP('box',#31);
#31=CLOSED_SHELL('',(#40,#41,#42,#43,#44,#45));
/* faces: bottom, top, front (y=0), back (y=20), left (x=0), right (x=10) */
#40=ADVANCED_FACE('bottom',(#50),#60,.T.);
#41=ADVANCED_FACE('top',(#51),#61,.T.);
#42=ADVANCED_FACE('front',(#52),#62,.T.);
#43=ADVANCED_FACE('back',(#53),#63,.T.);
#44=ADVANCED_FACE('left',(#54),#64,.T.);
#45=ADVANCED_FACE('right',(#55),#65,.T.);
#50=FACE_OUTER_BOUND('',#80,.T.);
#51=FACE_OUTER_BOUND('',#81,.T.);
#52=FACE_OUTER_BOUND('',#82,.T.);
#53=FACE_OUTER_BOUND('',#83,.T.);
#54=FACE_OUTER_BOUND('',#84,.T.);
#55=FACE_OUTER_BOUND('',#85,.T.);
/* planes, each with its z axis along the outward normal */
#60=PLANE('',#70);
#61=PLANE('',#71);
#62=PLANE('',#72);
#63=PLANE('',#73);
#64=PLANE('',#74);
#65=PLANE('',#75);
#70=AXIS2_PLACEMENT_3D('',#101,#305,#300);
#71=AXIS2_PLACEMENT_3D('',#105,#304,#300);
#72=AXIS2_PLACEMENT_3D('',#101,#303,#300);
#73=AXIS2_PLACEMENT_3D('',#104,#302,#300);
#74=AXIS2_PLACEMENT_3D('',#101,#301,#302);
#75=AXIS2_PLACEMENT_3D('',#102,#300,#302);
/* loops, counterclockwise seen from outside */
#80=EDGE_LOOP('',(#181,#182,#183,#184));
#81=EDGE_LOOP('',(#185,#186,#187,#188));
#82=EDGE_LOOP('',(#189,#190,#191,#192));
#83=EDGE_LOOP('',(#193,#194,#195,#196));
#84=EDGE_LOOP('',(#197,#198,#199,#200));
#85=EDGE_LOOP('',(#201,#202,#203,#204));
/* vertices */
#101=CARTESIAN_POINT('',(0.,0.,0.));
#102=CARTESIAN_POINT('',(10.,0.,0.));
#103=CARTESIAN_POINT('',(10.,20.,0.));
#104=CARTESIAN_POINT('',(0.,20.,0.));
#105=CARTESIAN_POINT('',(0.,0.,30.));
#106=CARTESIAN_POINT('',(10.,0.,30.));
#107=CARTESIAN_POINT('',(10.,20.,30.));
#108=CARTESIAN_POINT('',(0.,20.,30.));
#111=VERTEX_POINT('',#101);
#112=VERTEX_POINT('',#102);
#113=VERTEX_POINT('',#103);
#114=VERTEX_POINT('',#104);
#115=VERTEX_POINT('',#105);
#116=VERTEX_POINT('',#106);
#117=VERTEX_POINT('',#107);
#118=VERTEX_POINT('',#108);
/* edges: bottom 1-4, top 5-8, vertical 9-12; each line runs from the edge's
   start at parameter 0 to its end at parameter 1 */
#121=EDGE_CURVE('e1',#111,#112,#141,.T.);
#122=EDGE_CURVE('e2',#112,#113,#142,.T.);
#123=EDGE_CURVE('e3',#113,#114,#143,.T.);
#124=EDGE_CURVE('e4',#114,#111,#144,.T.);
#125=EDGE_CURVE('e5',#115,#116,#145,.T.);
#126=EDGE_CURVE('e6',#116,#117,#146,.T.);
#127=EDGE_CURVE('e7',#117,#118,#147,.T.);
#128=EDGE_CURVE('e8',#118,#115,#148,.T.);
#129=EDGE_CURVE('e9',#111,#115,#149,.T.);
#130=EDGE_CURVE('e10',#112,#116,#150,.T.);
#131=EDGE_CURVE('e11',#113,#117,#151,.T.);
#132=EDGE_CURVE('e12',#114,#118,#152,.T.);
#141=LINE('',#101,#161);
#142=LINE('',#102,#162);
#143=LINE('',#103,#163);
#144=LINE('',#104,#164);
#145=LINE('',#105,#165);
#146=LINE('',#106,#166);
#147=LINE('',#107,#167);
#148=LINE('',#108,#168);
#149=LINE('',#101,#169);
#150=LINE('',#102,#170);
#151=LINE('',#103,#171);
#152=LINE('',#104,#172);
#161=VECTOR('',#300,10.);
#162=VECTOR('',#302,20.);
#163=VECTOR('',#301,10.);
#164=VECTOR('',#303,20.);
#165=VECTOR('',#300,10.);
#166=VECTOR('',#302,20.);
#167=VECTOR('',#301,10.);
#168=VECTOR('',#303,20.);
#169=VECTOR('',#304,30.);
#170=VECTOR('',#304,30.);
#171=VECTOR('',#304,30.);
#172=VECTOR('',#304,30.);
/* bottom */
#181=ORIENTED_EDGE('',*,*,#124,.F.);
#182=ORIENTED_EDGE('',*,*,#123,.F.);
#183=ORIENTED_EDGE('',*,*,#122,.F.);
#184=ORIENTED_EDGE('',*,*,#121,.F.);
/* top */
#185=ORIENTED_EDGE('',*,*,#125,.T.);
#186=ORIENTED_EDGE('',*,*,#126,.T.);
#187=ORIENTED_EDGE('',*,*,#127,.T.);
#188=ORIENTED_EDGE('',*,*,#128,.T.);
/* front */
#189=ORIENTED_EDGE('',*,*,#121,.T.);
#190=ORIENTED_EDGE('',*,*,#130,.T.);
#191=ORIENTED_EDGE('',*,*,#125,.F.);
#192=ORIENTED_EDGE('',*,*,#129,.F.);
/* back */
#193=ORIENTED_EDGE('',*,*,#123,.T.);
#194=ORIENTED_EDGE('',*,*,#132,.T.);
#195=ORIENTED_EDGE('',*,*,#127,.F.);
#196=ORIENTED_EDGE('',*,*,#131,.F.);
/* left */
#197=ORIENTED_EDGE('',*,*,#124,.T.);
#198=ORIENTED_EDGE('',*,*,#129,.T.);
#199=ORIENTED_EDGE('',*,*,#128,.F.);
#200=ORIENTED_EDGE('',*,*,#132,.F.);
/* right */
#201=ORIENTED_EDGE('',*,*,#122,.T.);
#202=ORIENTED_EDGE('',*,*,#131,.T.);
#203=ORIENTED_EDGE('',*,*,#126,.F.);
#204=ORIENTED_EDGE('',*,*,#130,.F.);
/* directions +x, -x, +y, -y, +z, -z */
#300=DIRECTION('',(1.,0.,0.));
#301=DIRECTION('',(-1.,0.,0.));
#302=DIRECTION('',(0.,1.,0.));
#303=DIRECTION('',(0.,-1.,0.));
#304=DIRECTION('',(0.,0.,1.));
#305=DIRECTION('',(0.,0.,-1.));
/* colors: the solid red, the top face green */
#400=COLOUR_RGB('',1.,0.,0.);
#401=FILL_AREA_STYLE_COLOUR('',#400);
#402=FILL_AREA_STYLE('',(#401));
#403=SURFACE_STYLE_FILL_AREA(#402);
#404=SURFACE_SIDE_STYLE('',(#403));
#405=SURFACE_STYLE_USAGE(.BOTH.,#404);
#406=PRESENTATION_STYLE_ASSIGNMENT((#405));
#407=STYLED_ITEM('color',(#406),#30);
#410=COLOUR_RGB('',0.,1.,0.);
#411=FILL_AREA_STYLE_COLOUR('',#410);
#412=FILL_AREA_STYLE('',(#411));
#413=SURFACE_STYLE_FILL_AREA(#412);
#414=SURFACE_SIDE_STYLE('',(#413));
#415=SURFACE_STYLE_USAGE(.BOTH.,#414);
#416=PRESENTATION_STYLE_ASSIGNMENT((#415));
#417=STYLED_ITEM('color',(#416),#41);
#420=MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION('',(#407,#417),#14);
ENDSEC;
END-ISO-10303-21;
