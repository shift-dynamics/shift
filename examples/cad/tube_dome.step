ISO-10303-21;
HEADER;
/* A tube of radius 10 mm from z = 0 to z = 20 mm, capped by a hemisphere
   centred on (0, 0, 20) mm, in meters and radians (AP242): an open shell of
   two faces. The tube's side is bounded by its two circles alone, with no
   seam, and the dome by the top circle alone, with the pole of its sphere
   inside it. No edge carries curves in the parameters of its surfaces
   (pcurves). Written by hand for the tests of shift's STEP repair
   (test/test_cad_repair.cc). */
FILE_DESCRIPTION(('tube with a hemispherical dome'),'2;1');
FILE_NAME('tube_dome.step','2026-11-03T00:00:00',('shift'),(''),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
DATA;
/* product */
#1=APPLICATION_CONTEXT('managed model based 3d engineering');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','ap242_managed_model_based_3d_engineering',2011,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#5=PRODUCT('tube','tube','',(#3));
#6=PRODUCT_DEFINITION_FORMATION('','',#5);
#7=PRODUCT_DEFINITION('design','',#6,#4);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#20);
/* units: meter and radian */
#10=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT($,.METRE.));
#11=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#12=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#13=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#10,'distance_accuracy_value','');
#14=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#13))GLOBAL_UNIT_ASSIGNED_CONTEXT((#10,#11,#12))REPRESENTATION_CONTEXT('',''));
/* shape */
#20=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('tube',(#30,#21),#14);
#21=AXIS2_PLACEMENT_3D('',#22,#23,#24);
#22=CARTESIAN_POINT('',(0.,0.,0.));
#23=DIRECTION('',(0.,0.,1.));
#24=DIRECTION('',(1.,0.,0.));
#25=CARTESIAN_POINT('',(0.,0.,0.02));
#26=AXIS2_PLACEMENT_3D('',#25,#23,#24);
#30=SHELL_BASED_SURFACE_MODEL('tube',(#31));
#31=OPEN_SHELL('',(#40,#41));
/* surfaces */
#50=CYLINDRICAL_SURFACE('',#21,0.01);
#51=SPHERICAL_SURFACE('',#26,0.01);
/* vertices on the circles */
#60=CARTESIAN_POINT('',(0.01,0.,0.));
#61=CARTESIAN_POINT('',(0.01,0.,0.02));
#62=VERTEX_POINT('',#60);
#63=VERTEX_POINT('',#61);
/* circles, counterclockwise seen from above */
#70=CIRCLE('',#21,0.01);
#71=CIRCLE('',#26,0.01);
#80=EDGE_CURVE('bottom circle',#62,#62,#70,.T.);
#81=EDGE_CURVE('top circle',#63,#63,#71,.T.);
/* faces */
#40=ADVANCED_FACE('side',(#90,#91),#50,.T.);
#90=FACE_OUTER_BOUND('',#92,.T.);
#92=EDGE_LOOP('',(#94));
#94=ORIENTED_EDGE('',*,*,#80,.T.);
#91=FACE_BOUND('',#93,.T.);
#93=EDGE_LOOP('',(#95));
#95=ORIENTED_EDGE('',*,*,#81,.F.);
#41=ADVANCED_FACE('dome',(#96),#51,.T.);
#96=FACE_OUTER_BOUND('',#97,.T.);
#97=EDGE_LOOP('',(#98));
#98=ORIENTED_EDGE('',*,*,#81,.T.);
ENDSEC;
END-ISO-10303-21;
