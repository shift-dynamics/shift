ISO-10303-21;
HEADER;
/* Drive sprocket of an excavator track (20 t class): 21 teeth, engaging the bushings of a 190 mm pitch track at every second tooth; pitch circle radius 322.3 mm, tip circle 352.3 mm, bore 200 mm, 60 mm wide. Axis along z through the origin, the middle of its width at z = 0, a seat on the x axis. Each tooth: two flanks (arcs of radius 200 mm) and a tip (an arc of the tip circle) between seats (arcs of radius 30.5 mm about the pitch circle). In millimeters. Written by scripts/make_track_step.py for the tests of contact on STEP surfaces. */
FILE_DESCRIPTION(('sprocket'),'2;1');
FILE_NAME('sprocket.step','2026-11-04T00:00:00',('shift'),(''),'scripts/make_track_step.py','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
