ISO-10303-21;
HEADER;
/* One link of an excavator track (20 t class), 190 mm pitch: a bushing (59 mm diameter, 120 mm long) about the y axis between the inner link plates, a pin (38 mm diameter) at x = 190 mm between the outer plates, which straddle the next link's inner plates, and a triple grouser shoe 600 mm wide (16 mm plate, 26 mm grousers) at z = 50 mm, z pointing out of the track loop. In millimeters. Written by scripts/make_track_step.py for the tests of contact on STEP surfaces. */
FILE_DESCRIPTION(('track_link'),'2;1');
FILE_NAME('track_link.step','2026-11-04T00:00:00',('shift'),(''),'scripts/make_track_step.py','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
