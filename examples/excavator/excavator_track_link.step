ISO-10303-21;
HEADER;
/* One link of the track of examples/excavator/excavator_drive.json, from the undercarriage mesh: the shoe (one grouser) and the cranked link plates welded to it, a solid of the mesh's planar faces, and the bushing at its pin, a prism. Origin at the axis of the hinge with the previous link, x towards the pin (210 mm), y along it, z out of the track loop. In millimeters. */
FILE_DESCRIPTION(('excavator_track_link'),'2;1');
FILE_NAME('excavator_track_link.step','2026-11-04T00:00:00',('shift'),(''),'scripts/make_excavator_drive.py','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
