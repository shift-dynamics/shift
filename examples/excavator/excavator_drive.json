{
  // The excavator of excavator.json on tracks that drive it, on dry sand
  // (written by scripts/make_excavator_drive.py). The tracks, sprockets,
  // idlers and rollers are STEP parts taken from the undercarriage mesh: 46
  // links a side (excavator_track_link.step), a sprocket of 23 teeth, an
  // idler, 7 track rollers and 2 carrier rollers, placed as the mesh has them;
  // their contacts are on primitive shapes. The hydraulic cylinders hold the
  // arm, the swing brake the upper structure. A benchmark, not run by meson
  // test.
  "model_parameters": {
    "version": "2.0.0",
    "units": {
      "angle": "radians",
      "length": "meters",
      "mass": "kilograms",
      "time": "seconds"
    },
    "gravity": [0, 0, 9.81],
    "include_directories": ["."],
    "solvers": [
      {
        "type": "rnca",
        "infinity_norm_multiplier": 2.0
      }
    ],
    "integrators": [
      {
        // tighter tolerances take ODE113 tiny steps through the contacts of
        // the tracks for the same answer
        "type": "ode113",
        "time_span": 15.0,
        "time_step": 0.02,
        "relative_error": 0.0001,
        "absolute_error": 1e-06
      }
    ],
    "enable_contact_detection": true
  },
  "frames": [
    {
      "name": "ground",
      "T": [-27.75, -30.75, 0.0]
    }
  ],
  "terrain": [
    {
      // rigid ground, 60 m square, rolling gently, with the sand where the
      // machine drives
      "type": "basic",
      "name": "ground",
      "parent": [
        ["fixed"],
        "ground"
      ],
      "filename": "excavator_ground.tiff",
      "x_scale": 0.5,
      "y_scale": 0.5,
      "texture_filename": "qrc:/textures/dry_sand.jpg",
      "normal_map_filename": "qrc:/textures/dry_sand_normal.jpg",
      "texture_scale": 0.5,
      "regions": [
        {
          // deformable dry sand under the drive (x and y in the ground's
          // frame); the machine settles into it over the first 1 s
          "type": "scm",
          "name": "sand",
          "spacing": 0.05,
          "settle_time": 1.0,
          "soil": {
            "name": "dry_sand",
            "wall_friction": 0.24
