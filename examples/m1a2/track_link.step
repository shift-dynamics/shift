ISO-10303-21;
HEADER;
/* One link of a single pin track like the M1 tank's (an estimate of its shape): 190 mm pitch, 635 mm wide. The link's pin is the y axis, the next link's at x = 190 mm, z out of the track loop. A block between the pins that the wheels run on (its face at z = -40 mm), a rubber pad on the ground side, a center guide horn between the dual wheels and an end connector at each end of the pin (59 mm diameter), which the sprocket drives. In millimeters. Written by examples/m1a2/generate_m1a2.py. */
FILE_DESCRIPTION(('track_link'),'2;1');
FILE_NAME('track_link.step','2026-11-04T00:00:00',('shift'),(''),'examples/m1a2/generate_m1a2.py','','');
