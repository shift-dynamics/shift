option('log_level', type: 'integer', min: -1, max: 5, value: -1,
       description: 'Logging level: 5=Trace, 4=Debug, 3=Info, 2=Warning, 1=Error; -1 picks 4 for debug builds and 3 otherwise')
option('tests', type: 'feature', value: 'auto',
       description: 'Build the gtest suite (runs models from examples/)')
option('docs', type: 'feature', value: 'auto',
       description: 'Add the doxygen documentation target')
option('gui', type: 'feature', value: 'auto',
       description: 'Build the Qt 6 / Vulkan viewer (shift)')
option('cpu', type: 'string', value: 'x86-64',
       description: 'Target CPU passed to -march: x86-64 for portable binaries, native to optimize for the build machine (any -march value works)')
option('fp_trap', type: 'boolean', value: true,
       description: 'Trap floating point division by zero in shift-cli (SHIFT_FP_TRAP); disable for maximum simulation speed')
