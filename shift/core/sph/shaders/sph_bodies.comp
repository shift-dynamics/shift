#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 128) in;

// SPH pass 0: the bodies' markers on their bodies' poses at the start of the
// substep, bodies.w of the batch, with their velocities, into the A arrays

#include "sph_common.glsl"

layout(std430, binding = 0) buffer Position { vec4 position[]; };
layout(std430, binding = 1) buffer Velocity { vec4 velocity[]; };
layout(std430, binding = 2) readonly buffer Kind { uint kind[]; };
layout(std430, binding = 3) readonly buffer Id { uint id[]; };
layout(std430, binding = 4) readonly buffer Local { vec4 local[]; };
// per substep and body: the columns of R, t, v and w
layout(std430, binding = 5) readonly buffer Poses { vec4 poses[]; };

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if(i >= count || (kind[i] & kMarker) == 0 || MarkerBody(kind[i]) == 0) {
    return;
  }
  const uint b = MarkerBody(kind[i]) - 1;
  const uint p = (bodies.w * bodies.z + b) * 6;
  const vec4 l = local[id[i] - bodies.x];
  const vec4 c0 = poses[p], c1 = poses[p + 1], c2 = poses[p + 2];
  const vec4 t = poses[p + 3], v = poses[p + 4], w = poses[p + 5];
  const float r[3] = float[3](c0.x * l.x + c1.x * l.y + c2.x * l.z,
                              c0.y * l.x + c1.y * l.y + c2.y * l.z,
                              c0.z * l.x + c1.z * l.y + c2.z * l.z);
  position[i] = vec4(r[0] + t.x, r[1] + t.y, r[2] + t.z, position[i].w);
  velocity[i] = vec4(v.x + (w.y * r[2] - w.z * r[1]),
                     v.y + (w.z * r[0] - w.x * r[2]),
                     v.z + (w.x * r[1] - w.y * r[0]), 0.0);
}
