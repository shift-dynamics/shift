#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 128) in;

// SPH pass 1: the cell of each particle and marker, and the count of each
// cell of the hash table

#include "sph_common.glsl"

layout(std430, binding = 0) readonly buffer Position { vec4 position[]; };
layout(std430, binding = 1) writeonly buffer Hash { uint hashes[]; };
layout(std430, binding = 2) buffer Counts { uint counts[]; };

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if(i >= count) {
    return;
  }
  const uint hash = CellHash(Cell(position[i].xyz));
  hashes[i] = hash;
  atomicAdd(counts[hash], 1u);
}
