#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Denoised ray traced image: the denoised indirect illumination remodulated
// by the current frame's albedo, plus the current frame's direct sunlight,
// tonemapped. Temporal anti-aliasing follows, which resolves the texture and
// floor grid detail from the primary rays' jitter, blends in the exact
// progressive mean and applies gamma.
//
// The albedo is not the denoiser's accumulated one: that is resampled from
// the previous frame in every frame, which blurs the textures while the view
// moves (most at low frame rates, where they move far between frames), and
// averages each pixel's texture over the jitter, which loses the detail
// finer than a pixel that the anti-aliasing pass recovers when it scales
// the image up (a render scale below 1).

layout(std140, binding = 0) uniform Denoise { // keep in sync with svgf_*.comp
  mat4 previous_view_projection;
  vec4 params;   // x = pixel spread angle, y = maximum history length,
                 // z = history valid, w = a-trous step
  vec4 blend;    // x = progressive frames, y, z = blend start, end,
                 // w = maximum history length of the unmoved
  ivec4 control; // x = instance count
  mat4 view_projection; // current frame
  vec4 upscale;  // read by svgf_taa.comp
} u;

layout(rgba32f, binding = 1) uniform readonly image2D position;
layout(rgba16f, binding = 2) uniform readonly image2D current_illumination;
layout(rgba16f, binding = 4) uniform readonly image2D filtered;
layout(rgba16f, binding = 6) uniform writeonly image2D out_color;
layout(rgba16f, binding = 7) uniform readonly image2D direct_light;
layout(rgba16f, binding = 8) uniform readonly image2D current_albedo;

void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(out_color);
  if(pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }

  vec3 denoised;
  if(int(round(imageLoad(position, pixel).w)) == -1) {
    denoised = imageLoad(current_illumination, pixel).rgb; // sky radiance
  } else {
    vec3 albedo = imageLoad(current_albedo, pixel).rgb;
    denoised = imageLoad(filtered, pixel).rgb * albedo +
               imageLoad(direct_light, pixel).rgb;
  }
  imageStore(out_color, pixel, vec4(denoised / (denoised + vec3(1.0)), 1.0));
}
