#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// SVGF edge-avoiding a-trous wavelet filter, one iteration with step
// u.params.w (1, 2, 4, 8, 16). A 5x5 B3 spline kernel, weighted by
// - normal similarity,
// - distance of the tap from the plane of the center hit, relative to the
//   world footprint of the tap offset (a gradient free depth test),
// - luminance difference relative to the local standard deviation, from the
//   variance prefiltered by a 3x3 Gaussian,
// so the filter blurs noise but not geometry or lighting edges. The variance
// is filtered with squared weights. Input and output: illumination (rgb),
// variance (a).
//
// The output of the first iteration replaces the temporal history's
// illumination (keeping its length), as in the paper: the next frame then
// accumulates onto a less noisy history, which steadies the denoised image.

layout(std140, binding = 0) uniform Denoise { // keep in sync with svgf_*.comp
  mat4 previous_view_projection;
  vec4 params;   // x = pixel spread angle, y = maximum history length,
                 // z = history valid, w = a-trous step
  vec4 blend;    // x = progressive frames, y, z = blend start, end
  ivec4 control; // x = instance count
  mat4 view_projection; // current frame
} u;

layout(rgba32f, binding = 1) uniform readonly image2D position;
layout(rgba16f, binding = 2) uniform readonly image2D normal;
layout(rgba16f, binding = 3) uniform readonly image2D source;
layout(rgba16f, binding = 4) uniform writeonly image2D destination;
layout(rgba16f, binding = 5) uniform image2D history_illumination;

const float kSigmaLuminance = 4.0;
const float kSigmaNormal = 128.0;
const float kSigmaPlane = 1.0;

float Luminance(vec3 c) {
  return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

bool Inside(ivec2 p, ivec2 size) {
  return all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, size));
}

void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(position);
  if(pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }

  vec4 center = imageLoad(source, pixel);
  vec4 g = imageLoad(position, pixel);
  if(int(round(g.w)) == -1) {
    imageStore(destination, pixel, center); // sky
    return;
  }
  vec4 gn = imageLoad(normal, pixel);
  vec3 n = gn.xyz;
  int step = int(u.params.w);

  // 3x3 Gaussian of the variance for a less noisy luminance threshold
  float variance = 0.0;
  float variance_weight = 0.0;
  for(int dy = -1; dy <= 1; dy++) {
    for(int dx = -1; dx <= 1; dx++) {
      ivec2 tap = pixel + ivec2(dx, dy);
      if(Inside(tap, size)) {
        float w = (dx == 0 ? 0.5 : 0.25) * (dy == 0 ? 0.5 : 0.25);
        variance += w * imageLoad(source, tap).a;
        variance_weight += w;
      }
    }
  }
  variance /= variance_weight;

  float l = Luminance(center.rgb);
  float luminance_scale = kSigmaLuminance * sqrt(max(variance, 0.0)) + 1e-6;
  float footprint = u.params.x * gn.w; // world size of a pixel at the hit

  const float kernel[3] = float[](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
  float weight_sum = kernel[0] * kernel[0];
  vec3 sum_illumination = weight_sum * center.rgb;
  float sum_variance = weight_sum * weight_sum * center.a;
  for(int dy = -2; dy <= 2; dy++) {
    for(int dx = -2; dx <= 2; dx++) {
      if(dx == 0 && dy == 0) {
        continue;
      }
      ivec2 tap = pixel + ivec2(dx, dy) * step;
      if(!Inside(tap, size)) {
        continue;
      }
      vec4 tap_position = imageLoad(position, tap);
      if(int(round(tap_position.w)) == -1) {
        continue;
      }
      vec4 value = imageLoad(source, tap);
      vec3 tap_normal = imageLoad(normal, tap).xyz;
      float w_n = pow(max(dot(n, tap_normal), 0.0), kSigmaNormal);
      float w_z = exp(-abs(dot(n, tap_position.xyz - g.xyz)) /
                      (kSigmaPlane * footprint * length(vec2(dx, dy)) *
                         float(step) +
                       1e-6));
      float w_l = exp(-abs(Luminance(value.rgb) - l) / luminance_scale);
      float w = kernel[abs(dx)] * kernel[abs(dy)] * w_n * w_z * w_l;
      sum_illumination += w * value.rgb;
      sum_variance += w * w * value.a;
      weight_sum += w;
    }
  }
  vec3 filtered = sum_illumination / weight_sum;
  imageStore(destination, pixel,
             vec4(filtered, sum_variance / (weight_sum * weight_sum)));
  if(step == 1) {
    float history_length = imageLoad(history_illumination, pixel).a;
    imageStore(history_illumination, pixel, vec4(filtered, history_length));
  }
}
