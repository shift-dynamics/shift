#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;

// Path tracer over a two-level scene: one BVH per mesh in body coordinates,
// shared by the instances of the mesh, each carrying a body pose, and a BVH
// over the world space boxes of the instances (one instance per leaf).
// World convention: +z is down, so the sky is in the -z direction and the
// floor is a plane, given by its frame.
//
// One sample per pixel and frame. Besides the progressive mean of the
// radiance (exact once the view is static), the shader writes the inputs of
// the SVGF denoiser (svgf_*.comp): the illumination (radiance divided by the
// albedo of the primary hit) and a G-buffer of the primary hit.

struct RtTriangle {
  vec4 v0, v1, v2; // body coordinates
  vec4 n0, n1, n2;
};

struct BvhNode {
  vec3 box_min;
  int right_or_first;
  vec3 box_max;
  int triangle_count; // < 0: interior node
};

struct Instance {
  mat4 body_to_world;
  mat4 world_to_body;
  vec4 box_min;       // world space bounds
  vec4 box_max;
  vec4 albedo;        // w = normal map scale
  vec4 material;      // x = metallic, y = roughness, z = triplanar,
                      // w = 1 / texture scale
  ivec4 offsets;      // x = root node, y = base color, z = metallic
                      // roughness, w = normal texture layer; -1: none
  mat4 previous_body_to_world; // pose in the previous frame (reprojection)
};

// illumination of this frame's sample, radiance / albedo (sky: radiance)
layout(rgba16f, binding = 0) uniform writeonly image2D illumination;

layout(std140, binding = 1) uniform Uniforms {
  mat4 inverse_view;
  mat4 inverse_projection;
  vec4 camera_position;
  vec4 sun_direction; // unit vector towards the sun, w = intensity
  vec4 sun_color;
  vec4 sky_zenith;
  vec4 sky_horizon;
    vec4 floor_params;  // y = grid spacing, z = enabled, w = extent
  vec4 texture_params; // x = pixel spread angle, y = texture size
    ivec4 control;      // x = instance count, y = sample index (random
                      // numbers), z = frames accumulated since the view
                      // last changed
  mat4 floor_frame;   // columns: in-plane axes, normal up (out of the
                      // solid), origin
} u;

layout(std430, binding = 2) readonly buffer Triangles {
  RtTriangle triangles[];
};

layout(std430, binding = 3) readonly buffer Nodes {
  BvhNode nodes[];
};

layout(std430, binding = 4) readonly buffer Instances {
  Instance instances[];
};

// BVH over the instances: a leaf has triangle_count 1 and right_or_first =
// the instance index; node 0 is the root (u.control.x > 0)
layout(std430, binding = 11) readonly buffer InstanceNodes {
  BvhNode instance_nodes[];
};

// progressive mean of the radiance since the view last changed
layout(rgba32f, binding = 5) uniform image2D accumulation;

// texture layers of all materials
layout(binding = 6) uniform sampler2DArray textures;

// G-buffer of the primary hit: world position and instance (-1 sky, with the
// ray direction in xyz; -2 floor), normal and hit distance, albedo
layout(rgba32f, binding = 7) uniform writeonly image2D gbuffer_position;
layout(rgba16f, binding = 8) uniform writeonly image2D gbuffer_normal;
layout(rgba16f, binding = 9) uniform writeonly image2D gbuffer_albedo;
// direct sunlight: a delta light with hard shadows, so free of noise apart
// from the sub-pixel jitter; it bypasses the denoiser's temporal history,
// which would make moving shadows lag
layout(rgba16f, binding = 10) uniform writeonly image2D direct_light;

// the lights of the model, sampled like the sun, with shadows
#define LIGHTS_BINDING 12
#define IES_BINDING 13
#include "lights.glsl"

// CAD faces (cad_triangulate.comp): per triangle, -1 for a mesh's, else
// face * 2 + 1 if a hit must be inside the face's trims, face * 2 otherwise;
// the faces and their trims (MergeCadTrims)
layout(std430, binding = 14) readonly buffer TriangleFaces {
  int triangle_faces[];
};
#define CAD_TRIM
#define CAD_TRIM_ONLY
#define CAD_FACES_BINDING 15
#define CAD_SEGMENTS_BINDING 16
#define CAD_TRIM_INDEX_BINDING 17
#include "cad_common.glsl"

// (u, v) of a CAD triangle at a hit
vec2 TriangleUv(int k, vec2 bary) {
  RtTriangle t = triangles[k];
  return vec2(t.v0.w, t.n0.w) * (1.0 - bary.x - bary.y) +
         vec2(t.v1.w, t.n1.w) * bary.x + vec2(t.v2.w, t.n2.w) * bary.y;
}

const float PI = 3.14159265358979;
const float kInfinity = 1e30;

// ---------------------------------------------------------------------------
// random numbers

uint seed;

uint Hash(uint x) {
  x ^= x >> 16u;
  x *= 0x7feb352du;
  x ^= x >> 15u;
  x *= 0x846ca68bu;
  x ^= x >> 16u;
  return x;
}

float Random() {
  seed = Hash(seed);
  return float(seed) * (1.0 / 4294967296.0);
}

// GGX distributed half vector about n, alpha = roughness^2
vec3 SampleGgx(vec3 n, float alpha) {
  float phi = 2.0 * PI * Random();
  float v = Random();
  float cos_theta = sqrt((1.0 - v) / (1.0 + (alpha * alpha - 1.0) * v));
  float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
  vec3 a = abs(n.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
  vec3 t = normalize(cross(a, n));
  vec3 b = cross(n, t);
  return normalize(t * (sin_theta * cos(phi)) + b * (sin_theta * sin(phi)) +
                   n * cos_theta);
}

vec3 CosineHemisphere(vec3 n) {
  float phi = 2.0 * PI * Random();
  float r2 = Random();
  float r = sqrt(r2);
  vec3 a = abs(n.x) < 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
  vec3 t = normalize(cross(a, n));
  vec3 b = cross(n, t);
  return normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(1.0 - r2));
}

// ---------------------------------------------------------------------------
// environment, keep in sync with sky.frag and floor.frag

// with_sun: false for bounce rays, since the sun is sampled explicitly
vec3 Sky(vec3 d, bool with_sun) {
  float altitude = -d.z;
  vec3 color;
  if(altitude >= 0.0) {
    color = mix(u.sky_horizon.rgb, u.sky_zenith.rgb, pow(altitude, 0.5));
  } else {
    color = mix(u.sky_horizon.rgb, vec3(0.12, 0.11, 0.10),
                clamp(-altitude * 4.0, 0.0, 1.0));
  }
  if(with_sun) {
    float s = max(dot(d, u.sun_direction.xyz), 0.0);
    color += u.sun_color.rgb * (pow(s, 1500.0) * 20.0 + pow(s, 30.0) * 0.15);
  }
  return color;
}

// exact line coverage: jittered samples accumulated over frames filter the
// lines, so no footprint estimate is needed. Keep widths and colors in sync
// with floor.frag.
float GridLine(vec2 uv, float width) {
  vec2 grid_uv = 1.0 - abs(fract(uv) * 2.0 - 1.0); // 0 on a line
  return (grid_uv.x < width || grid_uv.y < width) ? 1.0 : 0.0;
}

vec3 FloorAlbedo(vec2 p, float spacing) {
  float minor = GridLine(p / spacing, 0.02);
  float major = GridLine(p / (10.0 * spacing), 0.004);
  return mix(vec3(0.42, 0.42, 0.40), vec3(0.22, 0.22, 0.22),
             max(minor * 0.6, major));
}

// ---------------------------------------------------------------------------
// intersection

bool BoxHit(vec3 origin, vec3 inverse_direction, vec3 box_min, vec3 box_max,
            float t_max) {
  vec3 t0 = (box_min - origin) * inverse_direction;
  vec3 t1 = (box_max - origin) * inverse_direction;
  vec3 near = min(t0, t1);
  vec3 far = max(t0, t1);
  float t_near = max(max(near.x, near.y), near.z);
  float t_far = min(min(far.x, far.y), far.z);
  return t_far >= max(t_near, 0.0) && t_near < t_max;
}

bool TriangleHit(vec3 origin, vec3 direction, vec3 v0, vec3 v1, vec3 v2,
                 out float t, out vec2 bary) {
  vec3 e1 = v1 - v0;
  vec3 e2 = v2 - v0;
  vec3 p = cross(direction, e2);
  float det = dot(e1, p);
  if(abs(det) < 1e-12) {
    return false;
  }
  float inverse_det = 1.0 / det;
  vec3 s = origin - v0;
  float b1 = dot(s, p) * inverse_det;
  if(b1 < 0.0 || b1 > 1.0) {
    return false;
  }
  vec3 q = cross(s, e1);
  float b2 = dot(direction, q) * inverse_det;
  if(b2 < 0.0 || b1 + b2 > 1.0) {
    return false;
  }
  t = dot(e2, q) * inverse_det;
  bary = vec2(b1, b2);
  return t > 0.0;
}

struct Hit {
  float t;
  int instance;  // -1: none, -2: floor
  int triangle;
  vec2 bary;
};

// closest hit when any_hit is false, otherwise stops at the first hit
bool Trace(vec3 origin, vec3 direction, float t_max, bool any_hit,
           out Hit hit) {
  hit.t = t_max;
  hit.instance = -1;
  hit.triangle = -1;
  hit.bary = vec2(0.0);

  vec3 inverse_world_direction = 1.0 / direction;
  int stack[64];
  int instance_stack[64];
  int isp = 0;
  if(u.control.x > 0) {
    instance_stack[isp++] = 0;
  }

  while(isp > 0) {
    int instance_node_index = instance_stack[--isp];
    BvhNode instance_node = instance_nodes[instance_node_index];
    // a leaf's box is the box of its instance
    if(!BoxHit(origin, inverse_world_direction, instance_node.box_min,
               instance_node.box_max, hit.t)) {
      continue;
    }
    if(instance_node.triangle_count < 0) {
      if(isp < 62) {
        instance_stack[isp++] = instance_node.right_or_first;
        instance_stack[isp++] = instance_node_index + 1;
      }
      continue;
    }
    int i = instance_node.right_or_first;
    // rigid transform: the ray parameter t is the same in both frames
    vec3 o = (instances[i].world_to_body * vec4(origin, 1.0)).xyz;
    vec3 d = mat3(instances[i].world_to_body) * direction;
    vec3 inverse_d = 1.0 / d;

    int sp = 0;
    stack[sp++] = instances[i].offsets.x;
    while(sp > 0) {
      int index = stack[--sp];
      BvhNode node = nodes[index];
      if(!BoxHit(o, inverse_d, node.box_min, node.box_max, hit.t)) {
        continue;
      }
      if(node.triangle_count >= 0) {
        for(int j = 0; j < node.triangle_count; j++) {
          int k = node.right_or_first + j;
          float t;
          vec2 bary;
          if(TriangleHit(o, d, triangles[k].v0.xyz, triangles[k].v1.xyz,
                         triangles[k].v2.xyz, t, bary) &&
             t < hit.t) {
            // a CAD face's triangle sticking out of its trims
            int face = triangle_faces[k];
            if(face >= 0 && (face & 1) != 0 &&
               !InsideTrims(face >> 1, TriangleUv(k, bary))) {
              continue;
            }
            hit.t = t;
            hit.instance = i;
            hit.triangle = k;
            hit.bary = bary;
            if(any_hit) {
              return true;
            }
          }
        }
      } else if(sp < 62) {
        stack[sp++] = node.right_or_first;
        stack[sp++] = index + 1;
      }
    }
  }

    // the floor is hit from above, its free side
  float toward_floor = dot(direction, u.floor_frame[2].xyz);
  if(u.floor_params.z > 0.5 && toward_floor < -1e-6) {
    float t = dot(u.floor_frame[3].xyz - origin, u.floor_frame[2].xyz) /
              toward_floor;
    if(t > 0.0 && t < hit.t) {
      hit.t = t;
      hit.instance = -2;
    }
  }
  return hit.instance != -1;
}

struct Surface {
  vec3 position;
  vec3 normal;
  vec3 albedo;
  float metallic;
  float roughness;
};

// ---------------------------------------------------------------------------
// materials, keep in sync with mesh.frag. Without screen space derivatives,
// texture levels of detail follow from the ray footprint.

vec3 SrgbToLinear(vec3 c) {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)),
             step(vec3(0.04045), c));
}

vec4 SampleLayer(int layer, vec2 p, float lod) {
  return textureLod(textures, vec3(p, float(layer)), lod);
}

vec4 SampleTriplanar(int layer, vec3 p, vec3 w, float lod) {
  return SampleLayer(layer, p.zy, lod) * w.x +
         SampleLayer(layer, p.xz, lod) * w.y +
         SampleLayer(layer, p.xy, lod) * w.z;
}

vec3 TriplanarNormal(int layer, vec3 p, vec3 n, vec3 w, float scale, float lod) {
  vec3 tx = SampleLayer(layer, p.zy, lod).xyz * 2.0 - 1.0;
  vec3 ty = SampleLayer(layer, p.xz, lod).xyz * 2.0 - 1.0;
  vec3 tz = SampleLayer(layer, p.xy, lod).xyz * 2.0 - 1.0;
  tx.xy *= scale;
  ty.xy *= scale;
  tz.xy *= scale;
  tx = vec3(tx.xy + n.zy, abs(tx.z) * n.x);
  ty = vec3(ty.xy + n.xz, abs(ty.z) * n.y);
  tz = vec3(tz.xy + n.xy, abs(tz.z) * n.z);
  return normalize(tx.zyx * w.x + ty.xzy * w.y + tz.xyz * w.z);
}

Surface GetSurface(vec3 origin, vec3 direction, Hit hit) {
  Surface s;
  s.position = origin + direction * hit.t;
  if(hit.instance == -2) {
        s.normal = u.floor_frame[2].xyz;
    vec3 on_floor = s.position - u.floor_frame[3].xyz;
    s.albedo = FloorAlbedo(vec2(dot(on_floor, u.floor_frame[0].xyz),
                                dot(on_floor, u.floor_frame[1].xyz)),
                           u.floor_params.y);
    s.metallic = 0.0;
    s.roughness = 0.9;
    return s;
  }

  Instance instance = instances[hit.instance];
  RtTriangle tri = triangles[hit.triangle];
  float b0 = 1.0 - hit.bary.x - hit.bary.y;
  vec3 e1 = tri.v1.xyz - tri.v0.xyz;
  vec3 e2 = tri.v2.xyz - tri.v0.xyz;
  vec3 face = cross(e1, e2);
  vec3 nb = tri.n0.xyz * b0 + tri.n1.xyz * hit.bary.x + tri.n2.xyz * hit.bary.y;
  if(dot(nb, nb) < 1e-12) {
    nb = face;
  }
  nb = normalize(nb);
  mat3 rotation = mat3(instance.body_to_world);
  // two sided: seen from behind, the surface is lit as its back face, whose
  // normal (normal mapped too) is the opposite of the front face's
  float side = dot(rotation * nb, direction) > 0.0 ? -1.0 : 1.0;
  nb *= side;

  vec2 uv0 = vec2(tri.v0.w, tri.n0.w);
  vec2 uv1 = vec2(tri.v1.w, tri.n1.w);
  vec2 uv2 = vec2(tri.v2.w, tri.n2.w);
  vec2 uv = uv0 * b0 + uv1 * hit.bary.x + uv2 * hit.bary.y;
  vec2 d1 = uv1 - uv0;
  vec2 d2 = uv2 - uv0;
  float uv_det = d1.x * d2.y - d1.y * d2.x;

  bool triplanar = instance.material.z > 0.5;
  vec3 p = (instance.world_to_body * vec4(s.position, 1.0)).xyz *
           instance.material.w;
  vec3 w = pow(abs(nb), vec3(4.0));
  w /= w.x + w.y + w.z;

  // level of detail: texels covered by the ray footprint at the hit
  float texels_per_length =
    triplanar ? u.texture_params.y * instance.material.w
              : u.texture_params.y *
                  sqrt(abs(uv_det) / max(length(face), 1e-20));
  float lod = log2(max(hit.t * u.texture_params.x * texels_per_length, 1.0));

  s.albedo = instance.albedo.rgb;
  int cad_face = triangle_faces[hit.triangle];
  if(cad_face >= 0) {
    vec4 color = faces[cad_face >> 1].color;
    if(color.w > 0.5) {
      s.albedo = SrgbToLinear(color.rgb);
    }
  }
  s.metallic = instance.material.x;
  s.roughness = instance.material.y;
  if(instance.offsets.y >= 0) {
    vec4 t = triplanar ? SampleTriplanar(instance.offsets.y, p, w, lod)
                       : SampleLayer(instance.offsets.y, uv, lod);
    s.albedo *= SrgbToLinear(t.rgb);
  }
  if(instance.offsets.z >= 0) {
    vec4 t = triplanar ? SampleTriplanar(instance.offsets.z, p, w, lod)
                       : SampleLayer(instance.offsets.z, uv, lod);
    s.roughness *= t.g;
    s.metallic *= t.b;
  }
  if(instance.offsets.w >= 0) {
    if(triplanar) {
      nb = side * TriplanarNormal(instance.offsets.w, p, side * nb, w,
                                  instance.albedo.w, lod);
    } else if(abs(uv_det) > 1e-20) {
      // tangent frame of the triangle from its texture coordinates
      vec3 tangent = (e1 * d2.y - e2 * d1.y) / uv_det;
      vec3 bitangent = (e2 * d1.x - e1 * d2.x) / uv_det;
      vec3 front = side * nb;
      tangent = normalize(tangent - front * dot(front, tangent));
      float handedness =
        dot(cross(front, tangent), bitangent) < 0.0 ? -1.0 : 1.0;
      vec3 t = SampleLayer(instance.offsets.w, uv, lod).xyz * 2.0 - 1.0;
      t.xy *= instance.albedo.w;
      nb = side * normalize(mat3(tangent, cross(front, tangent) * handedness,
                                 front) * t);
    }
  }
  s.normal = normalize(rotation * nb);
  s.roughness = clamp(s.roughness, 0.05, 1.0);
  s.metallic = clamp(s.metallic, 0.0, 1.0);
  return s;
}

float DistributionGgx(float n_dot_h, float roughness) {
  float a2 = roughness * roughness * roughness * roughness;
  float d = n_dot_h * n_dot_h * (a2 - 1.0) + 1.0;
  return a2 / (PI * d * d);
}

float GeometrySmith(float n_dot_v, float n_dot_l, float roughness) {
  float k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
  return n_dot_v / (n_dot_v * (1.0 - k) + k) *
         n_dot_l / (n_dot_l * (1.0 - k) + k);
}

// Smith-Schlick visibility with the remapping k = alpha / 2 used for
// sampled (not analytic) light
float GeometrySmithIbl(float n_dot_v, float n_dot_l, float roughness) {
  float k = roughness * roughness / 2.0;
  return n_dot_v / (n_dot_v * (1.0 - k) + k) *
         n_dot_l / (n_dot_l * (1.0 - k) + k);
}

float Luminance(vec3 c) {
  return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// reflection of light from l towards v, with the colors of its diffuse and
// specular parts
vec3 Brdf(Surface s, vec3 v, vec3 l, vec3 diffuse_light,
          vec3 specular_light) {
  vec3 h = normalize(v + l);
  float n_dot_l = max(dot(s.normal, l), 0.0);
  float n_dot_v = max(dot(s.normal, v), 1e-4);
  vec3 f0 = mix(vec3(0.04), s.albedo, s.metallic);
  vec3 f = f0 + (1.0 - f0) * pow(1.0 - max(dot(h, v), 0.0), 5.0);
  vec3 specular = DistributionGgx(max(dot(s.normal, h), 0.0), s.roughness) *
                  GeometrySmith(n_dot_v, n_dot_l, s.roughness) * f /
                  (4.0 * n_dot_v * n_dot_l + 1e-4);
  vec3 diffuse = (1.0 - f) * (1.0 - s.metallic) * s.albedo / PI;
  return (diffuse * diffuse_light + specular * specular_light) * n_dot_l;
}

vec3 SunLight(Surface s, vec3 v, float epsilon) {
  vec3 l = u.sun_direction.xyz;
  if(dot(s.normal, l) <= 0.0) {
    return vec3(0.0);
  }
  Hit shadow;
  if(Trace(s.position + s.normal * epsilon, l, kInfinity, true, shadow)) {
    return vec3(0.0);
  }
  vec3 sun = u.sun_color.rgb * u.sun_direction.w;
  return Brdf(s, v, l, sun, sun);
}

// the lights of the model at s, with a shadow ray each, and their ambient
// light
vec3 ModelLights(Surface s, vec3 v, float epsilon) {
  vec3 color = lights.ambient.rgb * (1.0 - s.metallic) * s.albedo;
  for(int i = 0; i < min(lights.count.x, kMaxLights); i++) {
    vec3 l;
    float distance;
    float factor = LightAt(i, s.position, l, distance);
    if(factor <= 0.0 || dot(s.normal, l) <= 0.0) {
      continue;
    }
    Hit shadow;
    vec3 origin = s.position + s.normal * epsilon;
    if(Trace(origin, l, min(distance, kInfinity) - 2.0 * epsilon, true,
             shadow)) {
      continue;
    }
    color += factor * Brdf(s, v, l, lights.light[i].diffuse.rgb,
                           lights.light[i].specular.rgb);
  }
  return color;
}

// the lights of the model at a bounce surface, diffuse and unshadowed
vec3 ModelLightsDiffuse(vec3 position, vec3 normal) {
  vec3 color = lights.ambient.rgb;
  for(int i = 0; i < min(lights.count.x, kMaxLights); i++) {
    vec3 l;
    float distance;
    float factor = LightAt(i, position, l, distance);
    color += factor * lights.light[i].diffuse.rgb *
             max(dot(normal, l), 0.0) / PI;
  }
  return color;
}

// radiance leaving the primary hit s towards the camera, at distance t:
// returns the indirect part (one bounce) and the direct sunlight in direct
vec3 Shade(Surface s, vec3 direction, float t, out vec3 direct) {
  float epsilon = 1e-4 * max(t, 1.0);
  vec3 v = -direction;
  direct = SunLight(s, v, epsilon) + ModelLights(s, v, epsilon);
  vec3 color = vec3(0.0);

  // one bounce, sampling either the specular lobe (GGX distributed half
  // vectors) or the diffuse lobe (cosine weighted), in proportion to their
  // estimated reflectance
  float n_dot_v = max(dot(s.normal, v), 1e-4);
  vec3 f0 = mix(vec3(0.04), s.albedo, s.metallic);
  vec3 f_v = f0 + (1.0 - f0) * pow(1.0 - n_dot_v, 5.0);
  vec3 diffuse_albedo = (1.0 - f_v) * (1.0 - s.metallic) * s.albedo;
  float specular_weight = Luminance(f_v);
  float diffuse_weight = Luminance(diffuse_albedo);
  float p_specular = clamp(
    specular_weight / max(specular_weight + diffuse_weight, 1e-6), 0.05, 0.95);

  vec3 bounce_direction;
  vec3 throughput;
  if(Random() < p_specular) {
    vec3 h = SampleGgx(s.normal, s.roughness * s.roughness);
    bounce_direction = reflect(-v, h);
    float n_dot_l = dot(s.normal, bounce_direction);
    float v_dot_h = dot(v, h);
    if(n_dot_l <= 0.0 || v_dot_h <= 0.0) {
      return color; // sample below the surface
    }
    // f cos / pdf, with pdf = D (n.h) / (4 v.h)
    vec3 f = f0 + (1.0 - f0) * pow(1.0 - v_dot_h, 5.0);
    float g = GeometrySmithIbl(n_dot_v, n_dot_l, s.roughness);
    throughput = f * g * v_dot_h /
                 (n_dot_v * max(dot(s.normal, h), 1e-4) * p_specular);
  } else {
    bounce_direction = CosineHemisphere(s.normal);
    throughput = diffuse_albedo / (1.0 - p_specular);
  }

  vec3 bounce_origin = s.position + s.normal * epsilon;
  Hit bounce;
  vec3 incoming;
  if(Trace(bounce_origin, bounce_direction, kInfinity, false, bounce)) {
    Surface b = GetSurface(bounce_origin, bounce_direction, bounce);
    // second surface: unshadowed sun plus a constant sky term
    float n_dot_l = max(dot(b.normal, u.sun_direction.xyz), 0.0);
    incoming = b.albedo * (u.sun_color.rgb * u.sun_direction.w * n_dot_l / PI +
                           0.3 * u.sky_zenith.rgb +
                           ModelLightsDiffuse(b.position, b.normal));
  } else {
    incoming = Sky(bounce_direction, false);
  }
  color += incoming * throughput;
  return color;
}

// radical inverse of i in base b
float Halton(uint i, uint b) {
  float f = 1.0;
  float r = 0.0;
  while(i > 0u) {
    f /= float(b);
    r += f * float(i % b);
    i /= b;
  }
  return r;
}

void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(illumination);
  if(pixel.x >= size.x || pixel.y >= size.y) {
    return;
  }
  int frame = u.control.z;
  seed = Hash(uint(pixel.x + size.x * pixel.y) ^ Hash(uint(u.control.y)));

  // jittered primary ray for anti-aliasing: one sub-pixel offset per frame
  // for the whole image, from the Halton (2, 3) sequence. Independent random
  // offsets per pixel make neighboring pixels along every edge flip sides at
  // random, a flicker that temporal anti-aliasing cannot settle; a shared
  // low-discrepancy offset shifts edges coherently and its running mean
  // converges much faster.
  uint halton_index = uint(u.control.y) + 1u;
  vec2 jitter =
    vec2(Halton(halton_index, 2u), Halton(halton_index, 3u)) - 0.5;
  vec2 ndc = (vec2(pixel) + 0.5 + jitter) / vec2(size) * 2.0 - 1.0;
  vec4 view = u.inverse_projection * vec4(ndc, 1.0, 1.0);
  vec3 direction = normalize((u.inverse_view * vec4(view.xyz / view.w, 0.0)).xyz);
  vec3 origin = u.camera_position.xyz;

  vec3 color; // denoised part: indirect light, or the sky
  vec3 direct = vec3(0.0);
  vec3 albedo = vec3(1.0);
  Hit hit;
  if(Trace(origin, direction, kInfinity, false, hit)) {
    Surface s = GetSurface(origin, direction, hit);
    color = Shade(s, direction, hit.t, direct);
    // demodulation keeps texture detail out of the denoiser's blur; a floor
    // on the albedo avoids amplifying noise on black surfaces
    albedo = max(s.albedo, vec3(0.02));
    imageStore(gbuffer_position, pixel, vec4(s.position, float(hit.instance)));
    imageStore(gbuffer_normal, pixel, vec4(s.normal, hit.t));
  } else {
    color = Sky(direction, true);
    imageStore(gbuffer_position, pixel, vec4(direction, -1.0));
    imageStore(gbuffer_normal, pixel, vec4(0.0));
  }
  imageStore(illumination, pixel, vec4(color / albedo, 1.0));
  imageStore(gbuffer_albedo, pixel, vec4(albedo, 1.0));
  imageStore(direct_light, pixel, vec4(direct, 1.0));

  vec3 radiance = color + direct;
  vec3 mean = radiance;
  if(frame > 0) {
    vec3 previous = imageLoad(accumulation, pixel).rgb;
    mean = mix(previous, radiance, 1.0 / float(frame + 1));
  }
  imageStore(accumulation, pixel, vec4(mean, 1.0));
}
