digraph original {
size="12,18";

node[penwidth=3]
node[color=black]

"(0) fixed" -> "(1) undercarriage" [color=black, penwidth=2, label=" A"];
"(1) undercarriage" -> "(2) cabin" [color=black, penwidth=2, label=" B"];
"(2) cabin" -> "(3) boom" [color=black, penwidth=2, label=" C", weight=100];
node[color=yellow2]
"(3) boom" -> "(4) stick" [color=black, penwidth=2, label=" D",weight=5];
node[color=red2]
"(4) stick" -> "(7) bucket linkage 2" [color=red2, penwidth=2, label=" F"];
"(7) bucket linkage 2" -> "(6) bucket linkage 1" [color=red2, penwidth=2, label=" T"];


node[color=green2]
"(4) stick" -> "(14) bucket cylinder" [color=green2, penwidth=2, label=" K", weight = 1];
"(14) bucket cylinder" -> "(15) bucket rod" [color=green2, penwidth=2, label=" O"];
"(15) bucket rod" -> "(20) virtual body 5" [color=green2, penwidth=2, label=" S"];


#constraint
edge[style=dashed, dir=none]
"(20) virtual body 5" -> "(6) bucket linkage 1" [color=green2, penwidth=2, label=" v", weight=0];

node[shape=none, width=0, height=0, label=""];
edge[dir=none, penwidth=0];
#"(2) cabin" -> "test";
#"(11) boom rod 2" -> "test2";
#"(3) boom" -> "(9) boom cylinder 2";
# "(5) bucket" -> "(7) bucket linkage 2";
"(7) bucket linkage 2" -> "(14) bucket cylinder";
#"(14) bucket cylinder"->"(13) stick rod";

"(20) virtual body 5" [shape=octagon];

#{rank=same; "(0) fixed"};
#{rank=same; "(4) stick", "test2", "(12) stick cylinder"};
#{rank=same; "(10) boom rod 1", "(11) boom rod 2"}
#{rank=same; "(3) boom", "test", "(9) boom cylinder 2"}
#{rank=same; "(10) boom rod 1", "(16) virtual body 1"}
#{rank=same; "(11) boom rod 2", "(17) virtual body 2"}
#{rank=same; "(13) stick rod", "(18) virtual body 3"}
{rank=same; "(14) bucket cylinder", "(7) bucket linkage 2"}
{rank=same; "(15) bucket rod", "(6) bucket linkage 1"}
}
