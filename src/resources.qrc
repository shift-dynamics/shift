    <file alias="terrain_folder.png">icons/terrain_folder.png</file>
    <file alias="pointcloud_folder.png">icons/pointcloud_folder.png</file>

    <file alias="play_button.png">icons/play_button.png</file>
    <file alias="pause_button.png">icons/pause_button.png</file>

    <file alias="visible.png">icons/visible.png</file>
