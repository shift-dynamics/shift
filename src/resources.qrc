    <file alias="frame.png">icons/frame.png</file>
    <file alias="joint.png">icons/joint.png</file>
    <file alias="light.png">icons/light.png</file>
    <file alias="restraint.png">icons/restraint.png</file>
    <file alias="terrain.png">icons/terrain.png</file>
    <file alias="pointcloud.png">icons/pointcloud.png</file>
