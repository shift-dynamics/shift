<RCC>
  <qresource prefix="/shaders">
    <file alias="frame.glsl">shaders/frame.glsl</file>
    <file alias="flat.glsl">shaders/flat.glsl</file>
    <file alias="vertex_normal.glsl">shaders/vertex_normal.glsl</file>
    <file alias="gouraud.glsl">shaders/gouraud.glsl</file>
