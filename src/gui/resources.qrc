<RCC>
  <qresource prefix="/shaders">
    <file alias="frame.frag">shaders/frame.frag</file>
    <file alias="frame.vert">shaders/frame.vert</file>

    <file alias="simple.frag">shaders/simple.frag</file>
    <file alias="simple.vert">shaders/simple.vert</file>

    <file alias="flat.frag">shaders/flat.frag</file>
    <file alias="flat.geom">shaders/flat.geom</file>
    <file alias="flat.vert">shaders/flat.vert</file>

    <file alias="gouraud.frag">shaders/gouraud.frag</file>
    <file alias="gouraud.vert">shaders/gouraud.vert</file>

    <file alias="phong.frag">shaders/phong.frag</file>
    <file alias="phong.vert">shaders/phong.vert</file>

    <file alias="terrain.frag">shaders/terrain.frag</file>
    <file alias="terrain.tesc">shaders/terrain.tesc</file>
    <file alias="terrain.tese">shaders/terrain.tese</file>
    <file alias="terrain.vert">shaders/terrain.vert</file>

    <file alias="shadow_light.frag">shaders/shadow_light.frag</file>
    <file alias="shadow_light.vert">shaders/shadow_light.vert</file>

    <file alias="terrain_shadow.frag">shaders/terrain_shadow.frag</file>
    <file alias="terrain_shadow.tesc">shaders/terrain_shadow.tesc</file>
    <file alias="terrain_shadow.tese">shaders/terrain_shadow.tese</file>
    <file alias="terrain_shadow.vert">shaders/terrain_shadow.vert</file>

    <file alias="line.frag">shaders/line.frag</file>
    <file alias="line.vert">shaders/line.vert</file>

    <file alias="point_simple.frag">shaders/point_simple.frag</file>
    <file alias="point_simple.vert">shaders/point_simple.vert</file>

    <file alias="point_phong.frag">shaders/point_phong.frag</file>
    <file alias="point_phong.vert">shaders/point_phong.vert</file>

    <file alias="point_sprite.frag">shaders/point_sprite.frag</file>
    <file alias="point_sprite.vert">shaders/point_sprite.vert</file>

  </qresource>

  <qresource prefix="/html">
    <file alias="license.html">html/license.html</file>
    <file alias="about.html">html/about.html</file>
  </qresource>

  <qresource prefix="/icons">
    <file alias="assembly.png">icons/assembly.png</file>
    <file alias="body.png">icons/body.png</file>
    <file alias="camera.png">icons/camera.png</file>
    <file alias="device.png">icons/device.png</file>
    <file alias="frame.png">icons/frame.png</file>
    <file alias="joint.png">icons/joint.png</file>
    <file alias="light.png">icons/light.png</file>
    <file alias="restraint.png">icons/restraint.png</file>
    <file alias="scene.png">icons/scene.png</file>
    <file alias="clapper.png">icons/clapper.png</file>
    <file alias="anchor.png">icons/anchor.png</file>

    <file alias="body_dark.png">icons/body_dark.png</file>
    <file alias="camera_dark.png">icons/camera_dark.png</file>
    <file alias="device_dark.png">icons/device_dark.png</file>
    <file alias="frame_dark.png">icons/frame_dark.png</file>
    <file alias="joint_dark.png">icons/joint_dark.png</file>
    <file alias="light_dark.png">icons/light_dark.png</file>
    <file alias="restraint_dark.png">icons/restraint_dark.png</file>

    <file alias="play_button.png">icons/play_button.png</file>
    <file alias="pause_button.png">icons/pause_button.png</file>
  </qresource>

  <qresource prefix="/textures">
    <file alias="asphalt.jpg">textures/asphalt.jpg</file>
    <file alias="asphalt_normal.jpg">textures/asphalt_normal.jpg</file>
    <file alias="asphalt_specular.jpg">textures/asphalt_specular.jpg</file>
    <file alias="asphalt_disp.jpg">textures/asphalt_disp.jpg</file>

    <file alias="asphalt2.jpg">textures/asphalt2.jpg</file>
    <file alias="asphalt2_normal.jpg">textures/asphalt2_normal.jpg</file>
    <file alias="asphalt2_specular.jpg">textures/asphalt2_specular.jpg</file>
    <file alias="asphalt2_disp.jpg">textures/asphalt2_disp.jpg</file>

    <file alias="concrete.jpg">textures/concrete.jpg</file>
    <file alias="concrete_normal.jpg">textures/concrete_normal.jpg</file>
    <file alias="concrete_specular.jpg">textures/concrete_specular.jpg</file>

    <file alias="concrete_wall.jpg">textures/concrete_wall.jpg</file>
    <file alias="concrete_wall_normal.jpg">textures/concrete_wall_normal.jpg</file>
    <file alias="concrete_wall_specular.jpg">textures/concrete_wall_specular.jpg</file>

    <file alias="cracked_sand.jpg">textures/cracked_sand.jpg</file>
    <file alias="cracked_sand_normal.jpg">textures/cracked_sand_normal.jpg</file>
    <file alias="cracked_sand_specular.jpg">textures/cracked_sand_specular.jpg</file>
    <file alias="cracked_sand_disp.jpg">textures/cracked_sand_disp.jpg</file>

    <file alias="grass.jpg">textures/grass.jpg</file>
    <file alias="grass_normal.jpg">textures/grass_normal.jpg</file>
    <file alias="grass_specular.jpg">textures/grass_specular.jpg</file>
    <file alias="grass_disp.jpg">textures/grass_disp.jpg</file>

    <file alias="pebbles.jpg">textures/pebbles.jpg</file>
    <file alias="pebbles_normal.jpg">textures/pebbles_normal.jpg</file>
    <file alias="pebbles_specular.jpg">textures/pebbles_specular.jpg</file>
    <file alias="pebbles_disp.jpg">textures/pebbles_disp.jpg</file>

    <file alias="sphere.png">textures/sphere.png</file>
    <file alias="sphere_normal.png">textures/sphere_normal.png</file>
  </qresource>

</RCC>
